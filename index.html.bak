<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GWF Team</title>
    <!-- Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Poppins:wght@600;700&display=swap"
        rel="stylesheet">
    <!-- Animations (AOS) -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --peach: #fcd3c7;
            --green: #84e4a8;
            --blue: #90d4d7;
            --dark: #19191b;
            --gray: #787a82;
            --accent: #116dff;
            --bg: #ffffff;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--dark);
            overflow-x: hidden;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 60px 40px;
        }

        .header-section {
            text-align: center;
            margin-bottom: 80px;
            animation: fadeInDown 1s ease-out;
        }

        .header-section h4 {
            font-size: 14px;
            font-weight: 500;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 16px;
        }

        .header-section h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 48px;
            font-weight: 700;
            margin: 0 0 24px 0;
            color: var(--dark);
        }

        .header-section p {
            font-size: 18px;
            color: var(--gray);
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .role-section {
            margin-bottom: 80px;
        }

        .role-title {
            font-family: 'Poppins', sans-serif;
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 40px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--peach);
            display: inline-block;
            color: var(--dark);
        }

        .role-section:nth-child(even) .role-title {
            border-bottom-color: var(--green);
        }

        .role-section:nth-child(3n) .role-title {
            border-bottom-color: var(--blue);
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 40px;
        }

        .team-card {
            background: #fff;
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-align: center;
            padding-bottom: 30px;
            cursor: pointer;
            z-index: 1;
        }

        .team-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .card-bg {
            height: 140px;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -1;
            transition: height 0.4s ease;
        }

        .team-card:hover .card-bg {
            height: 180px;
        }

        .color-0 {
            background-color: var(--peach);
        }

        .color-1 {
            background-color: var(--green);
        }

        .color-2 {
            background-color: var(--blue);
        }

        .img-container {
            width: 180px;
            height: 180px;
            margin: 50px auto 20px;
            border-radius: 50%;
            overflow: hidden;
            border: 6px solid #fff;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            position: relative;
            background-color: #fff;
        }

        .img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .team-card:hover .img-container img {
            transform: scale(1.1);
        }

        .img-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0f0f0;
            font-family: 'Poppins', sans-serif;
            font-size: 48px;
            color: #ccc;
        }

        .member-name {
            font-family: 'Poppins', sans-serif;
            font-size: 22px;
            font-weight: 600;
            color: var(--dark);
            margin: 0 0 8px 0;
        }

        .member-designation {
            font-size: 14px;
            font-weight: 500;
            color: var(--accent);
            margin: 0 0 16px 0;
            padding: 0 20px;
            min-height: 40px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 20px;
        }

        .social-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f4f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dark);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-icon:hover {
            background: var(--accent);
            color: #fff;
            transform: translateY(-3px);
        }

        .social-icon svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        /* UNIQUE STYLES: Founder */
        .founder-wrapper {
            position: relative;
            margin-bottom: 60px;
            border-radius: 36px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }

        .founder-wrapper:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.12);
        }

        .founder-card {
            display: flex;
            background: var(--peach);
            border-radius: 36px;
            overflow: hidden;
            position: relative;
            align-items: center;
            padding: 50px 60px;
            gap: 60px;
            color: var(--dark);
        }

        /* A subtle animated glow inside */
        .founder-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.6) 0%, transparent 40%);
            animation: pulseGlow 8s infinite alternate ease-in-out;
            pointer-events: none;
        }

        @keyframes pulseGlow {
            0% {
                transform: scale(0.9) translate(0, 0);
            }

            100% {
                transform: scale(1.1) translate(10%, 10%);
            }
        }

        .founder-img-container {
            width: 300px;
            height: 300px;
            border-radius: 50%;
            /* Circle to contrast with square cards */
            overflow: hidden;
            position: relative;
            z-index: 1;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            flex-shrink: 0;
        }

        .founder-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s ease;
        }

        .founder-wrapper:hover .founder-img-container img {
            transform: scale(1.08);
        }

        .founder-info {
            z-index: 1;
            text-align: left;
            flex: 1;
        }

        .founder-info .role-badge {
            display: inline-block;
            background: #ffffff;
            color: var(--accent);
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .founder-info .member-name {
            font-size: 44px;
            margin: 0 0 8px 0;
            color: var(--dark);
        }

        .founder-info .member-designation {
            font-size: 20px;
            color: rgba(25, 25, 27, 0.7);
            padding: 0;
            margin: 0;
            font-weight: 600;
        }

        .founder-bio {
            color: rgba(25, 25, 27, 0.8);
            font-size: 17px;
            margin-top: 24px;
            line-height: 1.7;
            max-width: 95%;
        }

        .founder-info .social-links {
            justify-content: flex-start;
            margin-top: 35px;
        }

        .founder-info .social-icon {
            background: #fff;
            color: var(--dark);
        }

        .founder-info .social-icon:hover {
            background: var(--accent);
            color: #fff;
        }

        /* NEW STYLES: Shared Services */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 40px;
        }

        .service-card {
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
            padding-bottom: 40px;
            align-items: center;
            text-align: center;
            cursor: pointer;
            z-index: 1;
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.12);
        }

        .service-card .card-bg {
            height: 160px;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -1;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border-radius: 0 0 50% 50% / 0 0 50px 50px;
        }

        .service-card .card-bg.color-0 {
            background: linear-gradient(145deg, var(--peach) 10%, #ffece7 100%);
        }

        .service-card .card-bg.color-1 {
            background: linear-gradient(145deg, var(--green) 10%, #e6fcf0 100%);
        }

        .service-card .card-bg.color-2 {
            background: linear-gradient(145deg, var(--blue) 10%, #eaf8f9 100%);
        }

        .service-card:hover .card-bg {
            height: 200px;
            border-radius: 0 0 50% 50% / 0 0 70px 70px;
        }

        .service-card .img-container {
            width: 200px;
            height: 200px;
            margin: 60px auto 30px;
            border-radius: 50%;
            overflow: hidden;
            border: 8px solid #fff;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            position: relative;
            background-color: #fff;
            flex-shrink: 0;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .service-card:hover .img-container {
            transform: scale(1.06) translateY(-5px);
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.15);
        }

        .service-info {
            flex: 1;
            padding: 0 30px;
            width: 100%;
        }

        .service-info .member-name {
            font-size: 28px;
            margin-bottom: 8px;
            color: var(--dark);
        }

        .service-info .member-designation {
            font-size: 16px;
            padding: 0;
            margin-bottom: 20px;
            min-height: auto;
        }

        .service-info .social-links {
            justify-content: center;
            margin-top: 20px;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 900px) {
            .founder-card {
                flex-direction: column;
                text-align: center;
                gap: 30px;
                padding: 40px 20px;
                border-radius: 27px;
            }

            .founder-img-container {
                margin: 0 auto;
                width: 220px;
                height: 220px;
            }

            .founder-info {
                text-align: center;
                padding: 0;
            }

            .founder-info .member-name {
                font-size: 36px;
            }

            .founder-bio {
                margin: 20px auto 0;
                max-width: 100%;
            }

            .founder-info .social-links {
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 40px 20px;
            }

            .header-section h1 {
                font-size: 36px;
            }

            .team-grid {
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .desktop-nav {
                display: none;
            }

            .header-container {
                padding: 15px 20px;
            }
        }

        /* HEADER STYLES */
        .main-header {
            background-color: #fff;
            height: 81px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .header-logo {
            padding-left: 81px;
        }

        .header-logo img {
            height: 60px;
            display: block;
        }

        .header-actions {
            display: flex;
            height: 100%;
        }

        .header-actions>* {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #000;
            text-decoration: none;
            transition: opacity 0.3s ease;
        }

        .header-actions>*:hover {
            opacity: 0.85;
        }

        .header-donate {
            background-color: #8de2a6;
            width: 120px;
        }

        .header-action {
            background-color: #a1d5d8;
            width: 120px;
        }

        .header-about {
            background-color: #ffdacb;
            padding: 0 60px;
            gap: 80px;
        }

        .hamburger-icon {
            display: flex;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
        }

        .hamburger-icon span {
            display: block;
            width: 30px;
            height: 3px;
            background-color: #000;
            border-radius: 2px;
        }

        /* FOOTER STYLES */
        .main-footer {
            background-color: #fff;
            padding: 80px 40px 40px;
            margin-top: 100px;
            text-align: left;
            border-top: 1px solid #f0f0f0;
        }

        .footer-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            margin-bottom: 60px;
            max-width: 1200px;
            margin: 0 auto 60px;
        }

        .footer-title {
            font-size: 32px;
            font-family: inherit;
            font-weight: 400;
            color: var(--dark);
            margin-bottom: 30px;
            letter-spacing: -0.5px;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 20px;
            align-items: baseline;
            margin-bottom: 10px;
        }

        .contact-label {
            font-size: 12px;
            font-weight: 500;
            color: #555;
            text-transform: uppercase;
        }

        .contact-value {
            font-size: 15px;
            color: var(--dark);
            font-family: 'Inter', sans-serif;
        }

        .bold-contact-text {
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: #000;
            line-height: 1.6;
            margin-top: 30px;
            margin-bottom: 10px;
        }

        .normal-contact-text {
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: #000;
            margin-bottom: 25px;
        }

        .footer-socials {
            display: flex;
            gap: 15px;
        }

        .footer-social-btn {
            width: 30px;
            height: 30px;
            background-color: #000;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .footer-social-btn:hover {
            opacity: 0.8;
            transform: translateY(-2px);
        }

        .footer-social-btn svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }

        .spread-word-text {
            font-size: 15px;
            color: #000;
            line-height: 1.6;
            margin-bottom: 20px;
            font-family: 'Inter', sans-serif;
        }

        .footer-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 10px;
        }

        .form-input {
            width: 100%;
            padding: 10px 0;
            border: none;
            border-bottom: 1px solid #ccc;
            background-color: transparent;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: border-color 0.3s ease;
        }

        .form-input:focus {
            outline: none;
            border-bottom-color: var(--dark);
        }

        .form-action-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 5px;
        }

        .submit-btn {
            background-color: #8de2a6;
            color: #000;
            padding: 10px 30px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 400;
            cursor: pointer;
            transition: background-color 0.3s ease;
            font-family: 'Inter', sans-serif;
        }

        .submit-btn:hover {
            opacity: 0.9;
        }

        .back-to-top {
            font-size: 14px;
            color: #000;
            text-decoration: none;
            font-family: 'Inter', sans-serif;
        }

        .back-to-top:hover {
            text-decoration: underline;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 40px;
        }

        .footer-text {
            color: #000;
            font-size: 13px;
            margin-bottom: 5px;
            font-family: 'Inter', sans-serif;
        }

        .footer-text strong {
            font-weight: 700;
        }

        .footer-bottom-links {
            margin-top: 30px;
            color: var(--dark);
            font-size: 13px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            font-family: 'Inter', sans-serif;
        }

        .footer-bottom-links a {
            color: var(--dark);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-bottom-links a:hover {
            opacity: 0.7;
        }

        @media (max-width: 900px) {
            .footer-top {
                grid-template-columns: 1fr;
                gap: 50px;
            }

            .header-logo {
                padding-left: 20px;
            }

            .header-about {
                padding: 0 20px;
                gap: 20px;
            }
        }

        @media (max-width: 768px) {
            .footer-bottom-links {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .footer-bottom-links span {
                display: none;
            }
        }
    </style>
</head>

<body>

    <header class="main-header">
        <a href="#" class="header-logo"><img src="./images/logo.png" alt="Good Wave Foundation Logo"></a>
        <div class="header-actions">
            <a href="#" class="header-donate">Donate</a>
            <a href="#" class="header-action">Take Action</a>
            <a href="#" class="header-about">
                About
                <div class="hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </a>
        </div>
    </header>

    <div class="container">
        <div class="header-section">
            <h4>Our Team</h4>
            <h1>Meet the Good Wave Team</h1>
            <p>Bringing passion and expertise to everything we do. Meet our inspiring team members driving positive
                change.</p>
        </div>

        <div id="team-container">
            <div class="role-section">
                <h2 class="role-title" data-aos="fade-right">Shared Services</h2>
                <div class="services-grid">
                    <!-- Asif Updahye moved here -->
                    <div class="service-card" data-aos="fade-up" data-aos-delay="0">
                        <div class="card-bg color-0"></div>
                        <div class="img-container">
                            <img src="images/Asif_Updahye.png" alt="Asif Updahye" loading="lazy">
                        </div>
                        <div class="service-info">
                            <h3 class="member-name">Asif Updahye</h3>
                            <p class="member-designation">Founder & CEO</p>
                            <div class="social-links">
                                <a href="#" class="social-icon" target="_blank" rel="noopener noreferrer"
                                    aria-label="LinkedIn">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                        <path
                                            d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="service-card" data-aos="fade-up" data-aos-delay="100">
                        <div class="card-bg color-1"></div>
                        <div class="img-container">
                            <img src="images/Elena_Raymond.jpg" alt="Elena Raymond " loading="lazy">
                        </div>
                        <div class="service-info">
                            <h3 class="member-name">Elena Raymond </h3>
                            <p class="member-designation">Human Resources & Talent Associate | Never Grow Up</p>
                            <div class="social-links">
                                <a href="#" class="social-icon" target="_blank" rel="noopener noreferrer"
                                    aria-label="LinkedIn">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                        <path
                                            d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="service-card" data-aos="fade-up" data-aos-delay="200">
                        <div class="card-bg color-2"></div>
                        <div class="img-container">
                            <img src="images/Rachael_Dmello.jpg" alt="Rachael Dmello" loading="lazy">
                        </div>
                        <div class="service-info">
                            <h3 class="member-name">Rachael Dmello</h3>
                            <p class="member-designation">Senior Human Resources & Talent Associate | Never Grow Up</p>
                            <div class="social-links">
                                <a href="#" class="social-icon" target="_blank" rel="noopener noreferrer"
                                    aria-label="LinkedIn">
